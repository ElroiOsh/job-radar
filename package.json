{
  "name": "job-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "daily": "tsx src/run-daily.ts",
    "build-web": "tsx src/run-daily.ts --skip-fetch --skip-email",
    "demo": "tsx src/run-daily.ts --demo --skip-email",
    "refresh-live": "node scripts/build-live-jobs.mjs && tsx src/run-daily.ts --skip-email",
    "serve": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
